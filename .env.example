# Postgres connection string from Neon (or any Postgres host)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Long random string used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Password for the single admin account (change this)
ADMIN_PASSWORD="change-me"

# Round 1 duration in seconds (configurable, not hardcoded in code)
ROUND1_DURATION_SECONDS=1200
